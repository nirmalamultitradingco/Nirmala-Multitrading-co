# ==========================================
# Vercel & Production Environment Variables
# ==========================================
# In your Vercel Project Settings -> Environment Variables, add:

# 1. MongoDB Atlas Connection URI (Required)
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/nmc?retryWrites=true&w=majority&appName=NMC

# 2. JWT Authentication Secret (Required)
JWT_SECRET=replace-with-a-secure-random-secret-string

# 3. Client & CORS Configuration (Optional)
CLIENT_URL=https://your-domain.vercel.app

# 4. Optional SMTP Mail Settings for Inquiries & Email OTP Backup
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
INQUIRY_NOTIFY_TO=

# 5. Optional SMS Gateway Configuration (for live SMS dispatch to +91 7069826082)
# Supported options: Fast2SMS (India) or Twilio (Global).
# When omitted, OTP codes are logged securely in the server console and sent via email backup.
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
