PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas example:
# mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/nmc?retryWrites=true&w=majority&appName=NMC
MONGO_URI=mongodb://127.0.0.1:27017/food_export

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

ADMIN_NAME=NMC Admin
ADMIN_EMAIL=admin@nmc.com
ADMIN_PASSWORD=change-this-password
ADMIN_PHONE=+91 7069826082

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
INQUIRY_NOTIFY_TO=

# Optional SMS Gateway settings (Fast2SMS or Twilio)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
